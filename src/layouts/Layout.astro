---
import '../styles/global.css';
import { profile } from '../data/content';
import MarketBackground from '../components/MarketBackground.astro';
import Nav from '../components/Nav.astro';
import Reveal from '../components/Reveal.astro';
import ModalController from '../components/ModalController.astro';
import BadgeLegend from '../components/BadgeLegend.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = `${profile.name} · ${profile.tagline}`,
	description = profile.blurb,
} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={profile.name} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		{/* Runs before the body paints, so a reader who chose light mode never
		    sees a flash of the dark palette first. is:inline keeps Astro from
		    bundling it into a deferred module, which would be too late. */}
		<script is:inline>
			(function () {
				try {
					var saved = localStorage.getItem('theme');
					// No stored choice: follow whatever the operating system prefers.
					var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
					document.documentElement.dataset.theme =
						saved || (prefersLight ? 'light' : 'dark');
				} catch (e) {
					document.documentElement.dataset.theme = 'dark';
				}
			})();
		</script>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<MarketBackground />
		<div class="page">
			<Nav />
			<slot />
		</div>
		<BadgeLegend />
		<Reveal />
		<ModalController />
	</body>
</html>

<style>
	.skip {
		position: absolute;
		left: -9999px;
		top: 0;
		background: var(--bg-raised);
		color: var(--text);
		padding: 0.75rem 1rem;
		border: 1px solid var(--border-strong);
		border-radius: 6px;
		z-index: 10;
	}

	.skip:focus {
		left: 1rem;
		top: 1rem;
	}
</style>
