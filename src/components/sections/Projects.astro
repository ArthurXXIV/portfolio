---
// Projects rendered as trading-terminal tickers: a symbol header, the detail
// body, and a sparkline that draws itself on hover.
import Droid from '../Droid.astro';
import Logo from '../Logo.astro';
import Sparkline from '../Sparkline.astro';
import { projects } from '../../data/content';
---

<section class="section" id="projects" aria-labelledby="projects-label">
	<div class="wrap">
		<h2 class="section-label reveal" id="projects-label">Projects &amp; Publications</h2>

		<div class="project-grid">
			{
				projects.map((project, i) => {
					// Widened so the fallback branch stays reachable for future entries.
					const href: string | null = project.href;
					return (
						<article class="tkr reveal" data-reveal-delay={i * 90}>
							<span class="tkr-crosshair" aria-hidden="true" />

							<header class="tkr-bar">
								<span class="tkr-symbol mono">{project.symbol}</span>
								<span class="tkr-tags">
									{project.tags.map((tag) => (
										<span class="tkr-tag mono">{tag}</span>
									))}
								</span>
								{project.featured && <Droid label="Featured" size={20} />}
							</header>

							<div class="tkr-body">
								<div class="tkr-ident">
									<Logo
										src={project.logo}
										name={project.name}
										size={38}
										plate={project.logoPlate}
										wide={project.logoWide}
									/>
									<div>
										<h3 class="tkr-name">
											{href ? (
												<a href={href} rel="noopener" target="_blank">
													{project.name}
												</a>
											) : (
												project.name
											)}
										</h3>
										<p class="tkr-sub mono muted">{project.subtitle}</p>
									</div>
								</div>

								<p class="tkr-text muted">{project.body}</p>

								{project.note && <p class="tkr-note mono">{project.note}</p>}

								{project.dataset && (
									<a class="tkr-dataset" href={project.dataset.href} target="_blank" rel="noopener">
										<span class="tkr-dataset-label mono">Kaggle dataset</span>
										<span class="tkr-dataset-name">{project.dataset.label}</span>
										<span class="tkr-dataset-arrow" aria-hidden="true">↗</span>
									</a>
								)}

								<ul class="chips">
									{project.stack.map((tech) => (
										<li class="chip">{tech}</li>
									))}
								</ul>
							</div>

							<footer class="tkr-chart">
								<Sparkline seed={project.symbol} />
							</footer>
						</article>
					);
				})
			}
		</div>
	</div>
</section>

<style>
	.project-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
		gap: 1.25rem;
	}

	.tkr {
		position: relative;
		display: flex;
		flex-direction: column;
		/* Thin glass: a lighter pane than the full frosted treatment, so the
		   ticker still reads as an instrument rather than a soft card. */
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 14px;
		background: rgba(255, 255, 255, 0.025);
		backdrop-filter: blur(10px) saturate(125%);
		-webkit-backdrop-filter: blur(10px) saturate(125%);
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.06);
		overflow: hidden;
		isolation: isolate;
		/* Written by the pointermove handler below. */
		--mx: -100px;
		transition: border-color 0.3s ease, box-shadow 0.3s ease,
			transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}

	/* Lifts toward the reader on hover and settles back on leave. */
	.tkr:hover {
		border-color: color-mix(in srgb, var(--accent) 50%, transparent);
		box-shadow: 0 20px 44px rgba(0, 0, 0, 0.5),
			0 0 28px color-mix(in srgb, var(--accent) 16%, transparent),
			inset 0 1px 0 rgba(255, 255, 255, 0.12);
		transform: translateY(-8px) scale(1.015);
	}

	/* Chart crosshair that follows the pointer horizontally. */
	.tkr-crosshair {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 1px;
		z-index: 2;
		pointer-events: none;
		transform: translateX(var(--mx));
		background: linear-gradient(
			180deg,
			transparent,
			color-mix(in srgb, var(--accent) 55%, transparent) 20%,
			color-mix(in srgb, var(--accent) 55%, transparent) 80%,
			transparent
		);
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.tkr:hover .tkr-crosshair {
		opacity: 1;
	}

	/* Terminal header strip. */
	.tkr-bar {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.6rem 0.9rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		background: rgba(255, 255, 255, 0.025);
	}

	.tkr-symbol {
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: var(--accent);
	}

	.tkr-tags {
		display: flex;
		gap: 0.35rem;
		margin-left: auto;
		flex-wrap: wrap;
	}

	.tkr-tag {
		font-size: 0.6rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-faint);
		border: 1px solid var(--border);
		border-radius: 2px;
		padding: 0.15rem 0.35rem;
	}

	.tkr-body {
		padding: 1.25rem 1.1rem 0.5rem;
		flex: 1;
	}

	.tkr-ident {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin-bottom: 0.9rem;
	}

	.tkr-name {
		font-size: 1.02rem;
	}

	.tkr-sub {
		margin: 0.2rem 0 0;
		font-size: 0.72rem;
	}

	.tkr-text {
		margin: 1rem 0;
		font-size: 0.94rem;
	}

	/* Attribution note, e.g. for shared or forked work. */
	.tkr-note {
		margin: 0 0 1rem;
		font-size: 0.72rem;
		line-height: 1.5;
		color: var(--text-faint);
		border-left: 2px solid var(--border-strong);
		padding-left: 0.7rem;
	}

	/* Published dataset link, shown only where one exists. */
	.tkr-dataset {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 1rem;
		padding: 0.6rem 0.75rem;
		border: 1px solid color-mix(in srgb, var(--accent-2) 30%, transparent);
		border-radius: 6px;
		background: color-mix(in srgb, var(--accent-2) 7%, transparent);
		text-decoration: none;
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.tkr-dataset:hover {
		border-color: var(--accent-2);
		box-shadow: 0 0 16px color-mix(in srgb, var(--accent-2) 22%, transparent);
	}

	.tkr-dataset-label {
		font-size: 0.58rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent-2);
	}

	.tkr-dataset-name {
		font-size: 0.8rem;
		color: var(--text);
	}

	.tkr-dataset-arrow {
		margin-left: auto;
		color: var(--accent-2);
		font-size: 0.8rem;
	}

	/* Sparkline strip pinned to the bottom of the card. */
	.tkr-chart {
		margin-top: auto;
		padding: 0 0.1rem;
		border-top: 1px solid rgba(255, 255, 255, 0.07);
		background: rgba(0, 0, 0, 0.18);
	}

	/* Sparkline internals live in Sparkline.astro, so reach them with :global. */
	.tkr:hover :global(.spark-line) {
		animation: draw 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
		opacity: 1;
	}

	.tkr:hover :global(.spark-area),
	.tkr:hover :global(.spark-dot) {
		opacity: 1;
		transition-delay: 0.5s;
	}

	@keyframes draw {
		to {
			stroke-dashoffset: 0;
		}
	}
</style>

<script>
	// Crosshair tracking, throttled to one update per animation frame.
	if (window.matchMedia('(pointer: fine)').matches) {
		document.querySelectorAll<HTMLElement>('.tkr').forEach((card) => {
			let frame = 0;

			card.addEventListener(
				'pointermove',
				(e) => {
					if (frame) return;
					frame = requestAnimationFrame(() => {
						frame = 0;
						const rect = card.getBoundingClientRect();
						card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
					});
				},
				{ passive: true }
			);
		});
	}

	// The draw animation needs each path's true length to start fully hidden.
	document.querySelectorAll<SVGPathElement>('.spark-line').forEach((line) => {
		line.style.setProperty('--len', String(line.getTotalLength()));
	});
</script>
