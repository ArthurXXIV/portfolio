---
// Contact channels as cards, plus the closing call to action.
import Icon from '../Icon.astro';
import { contact, profile } from '../../data/content';
---

<section class="section" id="contact" aria-labelledby="contact-label">
	<div class="wrap">
		<h2 class="section-label reveal" id="contact-label">Get in Touch</h2>

		<p class="about-text reveal">{contact.intro}</p>

		<ul class="contact-grid">
			{
				contact.channels.map((channel, i) => {
					// Channels without a link (e.g. location) render as a plain card.
					const Tag = channel.href ? 'a' : 'div';
					const attrs = channel.href
						? {
								href: channel.href,
								...(channel.href.startsWith('http') ? { target: '_blank', rel: 'me noopener' } : {}),
							}
						: {};

					return (
						<li class="reveal" data-reveal-delay={i * 80}>
							<Tag class="contact-card" {...attrs}>
								<span class="contact-head">
									<Icon name={channel.icon} size={15} />
									<span class="contact-label mono">{channel.label}</span>
								</span>
								<span class="contact-value">{channel.value}</span>
								{channel.href && (
									<span class="contact-arrow" aria-hidden="true">
										→
									</span>
								)}
							</Tag>
						</li>
					);
				})
			}
		</ul>

		<div class="contact-cta reveal">
			<a class="btn btn-primary" href={`mailto:${profile.email}`}>Email Me</a>
			<a class="btn" href={profile.resume}>Download Resume</a>
		</div>
	</div>
</section>

<style>
	.contact-grid {
		list-style: none;
		margin: 2.5rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: 1rem;
	}

	.contact-card {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		height: 100%;
		padding: 1.25rem 1.3rem;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: color-mix(in srgb, var(--bg-panel) 78%, transparent);
		backdrop-filter: blur(8px);
		text-decoration: none;
		position: relative;
		transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
	}

	a.contact-card:hover {
		border-color: var(--accent);
		transform: translateY(-3px);
		box-shadow: 0 0 26px color-mix(in srgb, var(--accent) 16%, transparent);
	}

	.contact-head {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--accent);
	}

	.contact-label {
		font-size: 0.66rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.contact-value {
		font-size: 0.94rem;
		color: var(--text);
		word-break: break-word;
	}

	.contact-arrow {
		position: absolute;
		top: 1.1rem;
		right: 1.1rem;
		color: var(--text-faint);
		transition: transform 0.25s ease, color 0.25s ease;
	}

	a.contact-card:hover .contact-arrow {
		color: var(--accent);
		transform: translate(3px, -3px);
	}

	.contact-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 2.25rem;
	}
</style>
