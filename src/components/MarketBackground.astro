---
// Animated background: scrolling market chart lines plus drifting up/down arrows.
// Purely decorative, hidden from assistive tech and disabled under reduced motion.
---

<canvas id="market-bg" aria-hidden="true"></canvas>

<style>
	#market-bg {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		pointer-events: none;
		/* Fade the field toward the edges so text stays readable. */
		mask-image: radial-gradient(120% 100% at 50% 0%, #000 35%, transparent 92%);
		-webkit-mask-image: radial-gradient(120% 100% at 50% 0%, #000 35%, transparent 92%);
	}

	/* Saturated lines that sit comfortably on near-black are shouty on a light
	   surface, so the whole field is pulled back in the light theme. */
	:global(html[data-theme='light']) #market-bg {
		opacity: 0.5;
	}

	@media (prefers-reduced-motion: reduce) {
		#market-bg {
			display: none;
		}
	}
</style>

<script>
	const canvas = document.getElementById('market-bg') as HTMLCanvasElement | null;
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (canvas && !reduced) {
		// Bind once so the null-narrowing survives into the nested draw functions.
		const cv = canvas;
		const ctx = cv.getContext('2d')!;
		// Read from the theme tokens rather than hardcoded, so the chart repaints
		// in the darker green and red when the light theme is active.
		let UP = '#4dff88';
		let DOWN = '#ff4d5e';

		const readThemeColors = () => {
			const style = getComputedStyle(document.documentElement);
			UP = style.getPropertyValue('--up').trim() || UP;
			DOWN = style.getPropertyValue('--down').trim() || DOWN;
		};

		readThemeColors();

		// The toggle in the nav flips data-theme on <html>; watch for it.
		new MutationObserver(readThemeColors).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-theme'],
		});

		let width = 0;
		let height = 0;
		let running = true;

		/** One scrolling price series drawn as a polyline. */
		type Series = {
			points: number[];
			x: number;
			speed: number;
			step: number;
			baseline: number;
			amplitude: number;
			drift: number;
			width: number;
			alpha: number;
		};

		/** A drifting ▲ / ▼ glyph. */
		type Arrow = {
			x: number;
			y: number;
			size: number;
			speed: number;
			up: boolean;
			alpha: number;
		};

		let series: Series[] = [];
		let arrows: Arrow[] = [];

		// `frozen` is reserved for the tab-hidden pause path below.
		let frozen = false;
		let looping = false;

		function rand(min: number, max: number) {
			return min + Math.random() * (max - min);
		}

		function buildSeries() {
			const count = width < 700 ? 3 : 5;
			series = Array.from({ length: count }, (_, i) => {
				const step = rand(26, 46);
				const s: Series = {
					points: [],
					x: 0,
					speed: rand(0.08, 0.2),
					step,
					baseline: height * rand(0.15, 0.85),
					amplitude: rand(14, 40),
					// Slight upward or downward bias so lines visibly trend.
					drift: rand(-0.9, 1.4),
					width: i % 2 === 0 ? 1.4 : 1,
					alpha: rand(0.1, 0.26),
				};
				const needed = Math.ceil(width / step) + 4;
				let v = s.baseline;
				for (let p = 0; p < needed; p++) {
					v += rand(-s.amplitude, s.amplitude) + s.drift;
					v = Math.max(height * 0.05, Math.min(height * 0.95, v));
					s.points.push(v);
				}
				return s;
			});
		}

		function buildArrows() {
			const count = width < 700 ? 10 : 20;
			arrows = Array.from({ length: count }, () => makeArrow(true));
		}

		function makeArrow(seed = false): Arrow {
			const up = Math.random() > 0.42;
			return {
				x: rand(0, width),
				y: seed ? rand(0, height) : up ? height + 40 : -40,
				size: rand(6, 13),
				speed: rand(0.05, 0.17),
				up,
				alpha: rand(0.15, 0.45),
			};
		}

		function resize() {
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			width = window.innerWidth;
			height = window.innerHeight;
			cv.width = Math.floor(width * dpr);
			cv.height = Math.floor(height * dpr);
			cv.style.width = width + 'px';
			cv.style.height = height + 'px';
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			buildSeries();
			buildArrows();
		}

		function drawSeries(s: Series) {
			// Trend colour is decided by the net movement across the visible span.
			const rising = s.points[s.points.length - 1] < s.points[0];
			ctx.strokeStyle = rising ? UP : DOWN;
			ctx.globalAlpha = s.alpha;
			ctx.lineWidth = s.width;
			ctx.lineJoin = 'round';
			ctx.lineCap = 'round';

			ctx.beginPath();
			for (let i = 0; i < s.points.length; i++) {
				const px = i * s.step - s.x;
				const py = s.points[i];
				if (i === 0) ctx.moveTo(px, py);
				else ctx.lineTo(px, py);
			}
			ctx.stroke();

			// Soft fill beneath the line for depth.
			ctx.globalAlpha = s.alpha * 0.14;
			ctx.lineTo(s.points.length * s.step - s.x, height);
			ctx.lineTo(-s.step, height);
			ctx.closePath();
			ctx.fillStyle = rising ? UP : DOWN;
			ctx.fill();
		}

		function stepSeries(s: Series) {
			s.x += s.speed;
			// Recycle the leftmost point once it scrolls off screen.
			if (s.x > s.step) {
				s.x -= s.step;
				s.points.shift();
				let v = s.points[s.points.length - 1] + rand(-s.amplitude, s.amplitude) + s.drift;
				v = Math.max(height * 0.05, Math.min(height * 0.95, v));
				s.points.push(v);
			}
		}

		function drawArrow(a: Arrow) {
			ctx.globalAlpha = a.alpha;
			ctx.fillStyle = a.up ? UP : DOWN;
			ctx.beginPath();
			if (a.up) {
				ctx.moveTo(a.x, a.y - a.size);
				ctx.lineTo(a.x + a.size * 0.72, a.y + a.size * 0.55);
				ctx.lineTo(a.x - a.size * 0.72, a.y + a.size * 0.55);
			} else {
				ctx.moveTo(a.x, a.y + a.size);
				ctx.lineTo(a.x + a.size * 0.72, a.y - a.size * 0.55);
				ctx.lineTo(a.x - a.size * 0.72, a.y - a.size * 0.55);
			}
			ctx.closePath();
			ctx.fill();
		}

		function stepArrow(a: Arrow, i: number) {
			a.y += a.up ? -a.speed : a.speed;
			if ((a.up && a.y < -50) || (!a.up && a.y > height + 50)) {
				arrows[i] = makeArrow();
			}
		}

		function frame() {
			if (!running || frozen) {
				looping = false;
				return;
			}
			ctx.clearRect(0, 0, width, height);

			for (const s of series) {
				drawSeries(s);
				stepSeries(s);
			}
			for (let i = 0; i < arrows.length; i++) {
				drawArrow(arrows[i]);
				stepArrow(arrows[i], i);
			}

			ctx.globalAlpha = 1;
			requestAnimationFrame(frame);
		}

		/** Restart the loop only if it isn't already running. */
		function ensureLooping() {
			if (looping || frozen || !running) return;
			looping = true;
			requestAnimationFrame(frame);
		}

		let resizeTimer: number;
		window.addEventListener('resize', () => {
			clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(() => {
				resize();
				ensureLooping();
			}, 150);
		});

		// Stop animating when the tab is hidden so we don't burn battery.
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) {
				running = false;
			} else {
				running = true;
				ensureLooping();
			}
		});

		resize();
		ensureLooping();
	}
</script>
