---
// Inline brand and utility glyphs. Kept as paths so they inherit currentColor
// and need no network request.

interface Props {
	name: 'github' | 'linkedin' | 'kaggle' | 'resume' | 'mail' | 'pin';
	size?: number;
}

const { name, size = 18 } = Astro.props;
---

<svg
	class="icon"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	aria-hidden="true"
	focusable="false"
	fill={name === 'github' || name === 'linkedin' ? 'currentColor' : 'none'}
	stroke={name === 'github' || name === 'linkedin' ? 'none' : 'currentColor'}
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
>
	{
		name === 'github' && (
			<path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.39 1.24-3.23-.12-.31-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.18.77.84 1.24 1.91 1.24 3.23 0 4.63-2.81 5.65-5.49 5.95.43.37.82 1.1.82 2.22v3.29c0 .32.21.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z" />
		)
	}

	{
		name === 'linkedin' && (
			<path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.59 0 4.26 2.36 4.26 5.44v6.3zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />
		)
	}

	{/* Kaggle: the K with its swept lower arm. */}
	{
		name === 'kaggle' && (
			<>
				<path d="M7.5 3v18" />
				<path d="M7.5 13.6 16 5.2" />
				<path d="M11 10.2c3.9 1.1 6 3.9 6.4 8.3" />
			</>
		)
	}

	{
		name === 'resume' && (
			<>
				<path d="M6 3h8l4 4v14H6z" />
				<path d="M14 3v5h4" />
				<path d="M9 13h6M9 16.5h4" />
			</>
		)
	}

	{
		name === 'mail' && (
			<>
				<rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
				<path d="m3 6.5 9 6.5 9-6.5" />
			</>
		)
	}

	{
		name === 'pin' && (
			<>
				<path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11z" />
				<circle cx="12" cy="10" r="2.6" />
			</>
		)
	}
</svg>

<style>
	.icon {
		display: block;
		flex: none;
	}
</style>
