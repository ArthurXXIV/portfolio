---
// Deterministic sparkline generated from a seed string, so a given project
// always renders the same "price history" across builds.

interface Props {
	seed: string;
	points?: number;
	width?: number;
	height?: number;
}

const { seed, points = 26, width = 240, height = 44 } = Astro.props;

// Small string hash -> repeatable pseudo-random sequence (mulberry32).
function hash(str: string) {
	let h = 2166136261;
	for (let i = 0; i < str.length; i++) {
		h ^= str.charCodeAt(i);
		h = Math.imul(h, 16777619);
	}
	return h >>> 0;
}

function mulberry32(a: number) {
	return () => {
		a |= 0;
		a = (a + 0x6d2b79f5) | 0;
		let t = Math.imul(a ^ (a >>> 15), 1 | a);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}

const rnd = mulberry32(hash(seed));

// Random walk with an upward bias, then normalised into the viewBox.
const raw: number[] = [];
let v = 0;
for (let i = 0; i < points; i++) {
	v += rnd() - 0.4;
	raw.push(v);
}

const min = Math.min(...raw);
const max = Math.max(...raw);
const span = max - min || 1;
const pad = 4;

const coords = raw.map((r, i) => {
	const x = (i / (points - 1)) * width;
	const y = height - pad - ((r - min) / span) * (height - pad * 2);
	return [x, y] as const;
});

const path = coords.map(([x, y], i) => `${i === 0 ? 'M' : 'L'}${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const area = `${path} L${width},${height} L0,${height} Z`;
const last = coords[coords.length - 1];

// Net direction decides the colour, matching the background chart's logic.
const rising = raw[raw.length - 1] >= raw[0];
const gradId = `sg-${seed.replace(/\W/g, '')}`;
---

<svg
	class="spark"
	viewBox={`0 0 ${width} ${height}`}
	preserveAspectRatio="none"
	aria-hidden="true"
	data-rising={String(rising)}
>
	<defs>
		<linearGradient id={gradId} x1="0" y1="0" x2="0" y2="1">
			<stop offset="0%" stop-color="currentColor" stop-opacity="0.28" />
			<stop offset="100%" stop-color="currentColor" stop-opacity="0" />
		</linearGradient>
	</defs>

	<path class="spark-area" d={area} fill={`url(#${gradId})`} />
	<path class="spark-line" d={path} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
	<circle class="spark-dot" cx={last[0]} cy={last[1]} r="2.8" fill="currentColor" />
</svg>

<style>
	.spark {
		display: block;
		width: 100%;
		height: 44px;
		color: var(--up);
		overflow: visible;
	}

	.spark[data-rising='false'] {
		color: var(--down);
	}

	/* Line is hidden until hover, then draws left-to-right. */
	.spark-line {
		stroke-dasharray: var(--len, 600);
		stroke-dashoffset: var(--len, 600);
		opacity: 0.55;
	}

	.spark-area,
	.spark-dot {
		opacity: 0;
		transition: opacity 0.35s ease;
	}

	.spark-dot {
		filter: drop-shadow(0 0 5px currentColor);
	}
</style>
